\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{klik-paper}[2026/09/22 KLIK research paper style]

\newif\ifklikbenchmark
\klikbenchmarkfalse
\DeclareOption{benchmark}{\klikbenchmarktrue}
\ProcessOptions\relax

\ifklikbenchmark\else
  \RequirePackage[margin=0.9in,headheight=15pt]{geometry}
  \RequirePackage{amsmath,amssymb,amsfonts}
  \RequirePackage{booktabs}
  \RequirePackage{tabularx}
  \RequirePackage{graphicx}
  \RequirePackage{enumitem}
  \RequirePackage{float}
  \RequirePackage[numbers,sort&compress]{natbib}
\fi
\RequirePackage{xcolor}
\RequirePackage{microtype}
\RequirePackage{fancyhdr}
\RequirePackage{hyperref}

\definecolor{klikblue}{HTML}{1F4E79}
\definecolor{klikgray}{HTML}{5B6573}
\hypersetup{
  colorlinks=true,
  linkcolor=blue!55!black,
  citecolor=blue!55!black,
  urlcolor=blue!65!black,
  pdfcreator={KLIK Research},
  pdfproducer={KLIK Research}
}

\pagestyle{fancy}
\fancyhf{}
\lhead{\small\textcolor{klikgray}{KLIK Research}}
\rhead{\small\textcolor{klikgray}{\thepage}}
\renewcommand{\headrulewidth}{0.3pt}
\renewcommand{\footrulewidth}{0pt}
\setlength{\headheight}{15pt}
\setlength{\emergencystretch}{3em}
\Urlmuskip=0mu plus 2mu\relax

\ifklikbenchmark\else
  \setlist{leftmargin=1.6em,itemsep=2pt,topsep=4pt}
  \setlength{\parindent}{1.2em}
  \setlength{\parskip}{0pt}
  \renewcommand{\arraystretch}{1.08}
  \makeatletter
  \renewenvironment{abstract}{%
    \small
    \begin{center}%
      {\bfseries\color{klikblue}\abstractname\vspace{-.4em}\vspace{0pt}}%
    \end{center}%
    \quotation
  }{\endquotation}
  \makeatother
\fi
\urlstyle{same}

\newcommand{\klikteam}{KLIK team}
\newcommand{\klikresearchnote}[1]{\thanks{KLIK Research. #1}}
